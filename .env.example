# Copy to .env and fill in. Never commit .env anywhere.
# 1) Free Alpaca keys: sign up at https://alpaca.markets -> "Your API keys"
ALPACA_KEY=
ALPACA_SECRET=

# 2) Optional second free provider (Finnhub) for symbols 31..39: https://finnhub.io
FINNHUB_KEY=

# 3) ntfy.sh push topic — install the free ntfy app (iOS/Android) and
#    subscribe to this exact topic name. Make it hard to guess:
#    ntfy.sh is a public server, the topic name is the only secret.
#    Example: stockbot-q8x2m-alerts   (NOT "myalerts")
NTFY_TOPIC=

# Optional overrides
# NTFY_SERVER=https://ntfy.sh
# PORT=8000
# DB_PATH=/home/hatch/workspace/goals/real-time-stock-alert-bot/stockbot.db
# SYMBOLS=AAPL,MSFT,NVDA   (seed watchlist on first run; comma-separated)
